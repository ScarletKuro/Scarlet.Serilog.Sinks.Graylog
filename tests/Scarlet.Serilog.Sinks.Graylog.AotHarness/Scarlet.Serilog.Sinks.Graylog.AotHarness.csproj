<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>11.0</LangVersion>
        <IsPackable>false</IsPackable>
        <!--A plain console app, not a test project - 'dotnet test' must not try to run it.-->
        <IsTestProject>false</IsTestProject>
        <!--Analyzers alone cannot prove Native AOT compatibility; the docs are explicit that the app has
            to be published and run. This project exists to be published, so any IL warning coming from the
            sink or its dependencies fails the build.-->
        <PublishAot>true</PublishAot>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!--Report every trimmer warning rather than collapsing them to one per assembly.-->
        <TrimmerSingleWarn>false</TrimmerSingleWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Scarlet.Serilog.Sinks.Graylog\Scarlet.Serilog.Sinks.Graylog.csproj" />
    </ItemGroup>
</Project>
