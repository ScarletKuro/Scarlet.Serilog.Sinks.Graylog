{
    "Serilog": {
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "restrictedToMinimumLevel": "Information",
                    "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss}] [{Level:u4}] {Message:lj} {NewLine}{Exception}"
                }
            },
            {
                "Name": "Graylog",
                "Args": {
                    "options": {
                        "transportType": "Http",
                        "message": { "facility": "MicroserviceTemplate.Host.WebApi", "hostnameOverride": "my_host" },
                        "http": { "endpoint": "http://localhost:12201" }
                    }
                }
            }
        ]
    }
}
