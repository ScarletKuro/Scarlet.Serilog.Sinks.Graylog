{
    "Serilog": {
        "Using": [ "Scarlet.Serilog.Sinks.Graylog" ],
        "MinimumLevel": "Information",
        "WriteTo": [
            {
                "Name": "Graylog",
                "Args": {
                    "options": {
                        "transportType": "Udp",
                        "udp": { "host": "localhost", "port": 12201 },
                        "delivery": {
                            "batching": {
                                "batchSizeLimit": 500,
                                "bufferingTimeLimit": "00:00:10",
                                "queueLimit": 4242,
                                "retryTimeLimit": "00:05:00",
                                "eagerlyEmitFirstEvent": false
                            }
                        }
                    }
                }
            }
        ]
    }
}
