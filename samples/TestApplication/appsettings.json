{

    "Serilog": {
        "Using": [ "Serilog.Sinks.Console", "Scarlet.Serilog.Sinks.Graylog" ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Information",
                "System": "Warning"
            }
        },
        "WriteTo": [
            { "Name": "Console" },
            {
                "Name": "Graylog",
                "Args": {
                    "options": {
                        "transportType": "Udp",
                        "udp": { "host": "localhost", "port": 12205 }
                    }
                }
            }
        ],
        "Properties": {
            "Application": "GraylogIssueDemo"
        }
    },

    "AllowedHosts": "*"
}
