<Project Sdk="Microsoft.NET.Sdk" ToolsVersion="15.0">

    <PropertyGroup>
        <LangVersion>11.0</LangVersion>
    </PropertyGroup>

    <PropertyGroup>
        <TargetFrameworks>net7.0;net6.0;netstandard2.0</TargetFrameworks>
        <!--Hack to include referenced project as content dll -->
        <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);CopyProjectReferencesToPackage</TargetsForTfmSpecificBuildOutput>

        <RestorePackages>true</RestorePackages>
        <DebugType>full</DebugType>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <WarningsAsErrors/>
        <PackageId>Scarlet.Serilog.Sinks.Graylog.Batching</PackageId>
        <Title>Scarlet.Serilog.Sinks.Graylog.Batching</Title>
        <Authors>ScarletKuro, Anton Volkov and Contributors</Authors>
        <Description>Community-maintained fork of Serilog.Sinks.Graylog.Batching. Batching version of Scarlet.Serilog.Sinks.Graylog Sink. The Serilog Graylog Sink project is a sink (basically a writer) for the Serilog logging framework. Structured log events are written to sinks and each sink is responsible for writing it to its own backend, database, store etc. This sink delivers the data to Graylog2, a NoSQL search engine.</Description>

        <PackageProjectUrl>https://github.com/ScarletKuro/Scarlet.Serilog.Sinks.Graylog</PackageProjectUrl>
        <RepositoryUrl>https://github.com/ScarletKuro/Scarlet.Serilog.Sinks.Graylog.git</RepositoryUrl>
        <PackageIcon>serilog-sink-nuget.png</PackageIcon>

        <Copyright>Copyright © Anton Volkov and Contributors; fork maintained by ScarletKuro</Copyright>

        <PackageIconUrl>http://serilog.net/images/serilog-sink-nuget.png</PackageIconUrl>
        <PackageTags>Serilog Sink Graylog Batching Scarlet</PackageTags>
        <NeutralLanguage>en</NeutralLanguage>
        <RepositoryType>git</RepositoryType>
        <SignAssembly>true</SignAssembly>
        <Version>3.0.3</Version>
        <AssemblyOriginatorKeyFile>sign.snk</AssemblyOriginatorKeyFile>
        <AssemblyVersion>3.0.0.0</AssemblyVersion>
        <FileVersion>3.0.0.0</FileVersion>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReleaseNotes>Renamed to Scarlet.Serilog.Sinks.Graylog.Batching. This is a fork of the unmaintained Serilog.Sinks.Graylog.Batching; the root namespace is now Scarlet.Serilog.Sinks.Graylog.Batching.</PackageReleaseNotes>

    </PropertyGroup>
    <ItemGroup>
        <EmbeddedResource Include="**\*.resx"/>

        <None Include="..\serilog-sink-nuget.png" Pack="true" Visible="false" PackagePath=""/>
        <None Remove="*.ncrunchproject"/>
        <None Include="sign.snk"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Serilog" Version="4.2.0" />
        <PackageReference Include="Serilog.Sinks.PeriodicBatching" Version="5.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Scarlet.Serilog.Sinks.Graylog.Core\Scarlet.Serilog.Sinks.Graylog.Core.csproj" PrivateAssets="all"/>
    </ItemGroup>

    <!--Hack to include referenced project as content dll -->
    <Target Name="CopyProjectReferencesToPackage" DependsOnTargets="ResolveReferences">
        <ItemGroup>
            <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths-&gt;WithMetadataValue('ReferenceSourceTarget', 'ProjectReference'))"/>
        </ItemGroup>
    </Target>

</Project>
