<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <LangVersion>11.0</LangVersion>
    </PropertyGroup>
    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;net8.0;net471;net462;netstandard2.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!--Enables the trimming, single-file and AOT analyzers, and marks the assembly trimmable.
            Conditional because these are unsupported on the .NET Framework and netstandard2.0 targets,
            which would otherwise fail with NETSDK1195.-->
        <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <WarningsAsErrors/>
        <PackageId>Scarlet.Serilog.Sinks.Graylog</PackageId>
        <Title>Scarlet.Serilog.Sinks.Graylog</Title>
        <Authors>ScarletKuro, Anton Volkov and Contributors</Authors>
        <Description>Community-maintained fork of Serilog.Sinks.Graylog. The Serilog Graylog Sink project is a sink (basically a writer) for the Serilog logging framework. Structured log events are written to sinks and each sink is responsible for writing it to its own backend, database, store etc. This sink delivers the data to Graylog2, a NoSQL search engine. Optional batching, built on Serilog's own batching support, is included in this package - the separate Serilog.Sinks.Graylog.Batching package is no longer needed.</Description>

        <RepositoryUrl>https://github.com/ScarletKuro/Scarlet.Serilog.Sinks.Graylog</RepositoryUrl>
        <PackageIcon>serilog-sink-nuget.png</PackageIcon>

        <PackageTags>Serilog Sink Graylog Batching Scarlet</PackageTags>
        <Copyright>Copyright © 2016 Anton Volkov and Contributors, © 2026 ScarletKuro and Contributors</Copyright>
        <NeutralLanguage>en</NeutralLanguage>

        <Version>4.0.0</Version>
        <AssemblyVersion>4.0.0.0</AssemblyVersion>
        <SignAssembly>true</SignAssembly>

        <AssemblyOriginatorKeyFile>..\..\sign.snk</AssemblyOriginatorKeyFile>
        <AssemblySignPublicKey></AssemblySignPublicKey>

        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Scarlet.Serilog.Sinks.Graylog.Tests, PublicKey=$(AssemblySignPublicKey)" />

        <None Include="..\serilog-sink-nuget.png" Pack="true" Visible="false" PackagePath=""/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Serilog" Version="4.3.1"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
        <!--Lets the .NET Framework targets build on non-Windows CI agents.-->
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all"/>
        <!--System.Net.Http is not an implicit framework reference on .NET Framework.-->
        <Reference Include="System.Net.Http"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net462'">
        <PackageReference Include="System.Net.Http.WinHttpHandler" Version="9.0.4"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFrameworkIdentifier)' != '.NETCoreApp'">
      <PackageReference Include="System.Text.Json" Version="9.0.19"/>
      <PackageReference Include="System.Memory" Version="4.5.5"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\README.md">
            <Link>README.md</Link>
        </None>
    </ItemGroup>

</Project>
